# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF

# Anthropic API key for bill OCR (Claude Vision)
ANTHROPIC_API_KEY=sk-ant-...
# Vision-capable model used for receipt parsing
ANTHROPIC_MODEL=claude-sonnet-4-5

# Path to SQLite database file (mounted as a volume in Docker)
DATABASE_PATH=./data/splitcheck.db

# debug | info | warn | error
LOG_LEVEL=info

# Default currency symbol for rendering
CURRENCY=₸
