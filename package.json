{
  "name": "splitcheck-bot",
  "version": "0.1.0",
  "description": "Telegram bot that reads a restaurant bill from a photo and splits it between chat members",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@grammyjs/runner": "^2.0.3",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.45.0",
    "grammy": "^1.46.0",
    "nanoid": "^5.1.0",
    "pino": "^9.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.30.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
